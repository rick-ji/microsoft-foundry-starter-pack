{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "18138957308296146174"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources. Defaults to the resource group location."
      }
    },
    "foundryAccountName": {
      "type": "string",
      "defaultValue": "[format('foundry-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 3,
      "maxLength": 64,
      "metadata": {
        "description": "Name of the Microsoft Foundry (AI Services) account."
      }
    },
    "customSubDomainName": {
      "type": "string",
      "defaultValue": "[toLower(parameters('foundryAccountName'))]",
      "metadata": {
        "description": "Globally unique custom subdomain, required for private endpoint / token auth. Defaults to the account name."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "S0",
      "allowedValues": [
        "S0"
      ],
      "metadata": {
        "description": "SKU for the Foundry account."
      }
    },
    "vnetNewOrExisting": {
      "type": "string",
      "defaultValue": "new",
      "allowedValues": [
        "new",
        "existing"
      ],
      "metadata": {
        "description": "Whether to create a NEW virtual network + subnet for the private endpoint, or use an EXISTING one."
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "foundry-vnet",
      "metadata": {
        "description": "Name of the virtual network (new or existing)."
      }
    },
    "vnetResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of the EXISTING virtual network. Ignored when creating a new VNet. Defaults to the current resource group."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Address space for the NEW virtual network. Ignored for existing VNets."
      }
    },
    "subnetName": {
      "type": "string",
      "defaultValue": "foundry-pe-subnet",
      "metadata": {
        "description": "Name of the subnet (new or existing) that hosts the private endpoint."
      }
    },
    "subnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.1.0/24",
      "metadata": {
        "description": "Address prefix for the NEW subnet. Ignored for existing subnets."
      }
    },
    "privateEndpointName": {
      "type": "string",
      "defaultValue": "[format('{0}-pe', parameters('foundryAccountName'))]",
      "metadata": {
        "description": "Name of the private endpoint."
      }
    },
    "privateDnsZoneNewOrExisting": {
      "type": "string",
      "defaultValue": "new",
      "allowedValues": [
        "new",
        "existing"
      ],
      "metadata": {
        "description": "Whether to create NEW private DNS zones or reuse EXISTING ones."
      }
    },
    "privateDnsZoneResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of EXISTING private DNS zones. Ignored when creating new zones. Defaults to the current resource group."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Optional resource tags applied to created resources."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "privateDnsZoneIds",
        "count": "[length(variables('privateDnsZoneNames'))]",
        "input": "[if(equals(parameters('privateDnsZoneNewOrExisting'), 'new'), resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneNames')[copyIndex('privateDnsZoneIds')]), resourceId(parameters('privateDnsZoneResourceGroup'), 'Microsoft.Network/privateDnsZones', variables('privateDnsZoneNames')[copyIndex('privateDnsZoneIds')]))]"
      }
    ],
    "privateDnsZoneNames": [
      "privatelink.cognitiveservices.azure.com",
      "privatelink.openai.azure.com",
      "privatelink.services.ai.azure.com"
    ],
    "vnetId": "[if(equals(parameters('vnetNewOrExisting'), 'new'), resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), resourceId(parameters('vnetResourceGroup'), 'Microsoft.Network/virtualNetworks', parameters('vnetName')))]",
    "subnetId": "[if(equals(parameters('vnetNewOrExisting'), 'new'), format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), parameters('subnetName')), resourceId(parameters('vnetResourceGroup'), 'Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('subnetName')))]"
  },
  "resources": [
    {
      "condition": "[equals(parameters('vnetNewOrExisting'), 'new')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('subnetName')]",
            "properties": {
              "addressPrefix": "[parameters('subnetAddressPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[parameters('foundryAccountName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "AIServices",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[toLower(parameters('customSubDomainName'))]",
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-11-01",
      "name": "[parameters('privateEndpointName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "subnet": {
          "id": "[variables('subnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-conn', parameters('privateEndpointName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
              "groupIds": [
                "account"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
      ]
    },
    {
      "copy": {
        "name": "newDnsZones",
        "count": "[length(variables('privateDnsZoneNames'))]"
      },
      "condition": "[equals(parameters('privateDnsZoneNewOrExisting'), 'new')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('privateDnsZoneNames')[copyIndex()]]",
      "location": "global",
      "tags": "[parameters('tags')]"
    },
    {
      "copy": {
        "name": "newDnsZoneLinks",
        "count": "[length(variables('privateDnsZoneNames'))]"
      },
      "condition": "[equals(parameters('privateDnsZoneNewOrExisting'), 'new')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('privateDnsZoneNames')[copyIndex()], format('link-to-{0}', parameters('vnetName')))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[variables('vnetId')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('privateDnsZoneNames')[copyIndex()])]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', parameters('privateEndpointName'), 'default')]",
      "properties": {
        "copy": [
          {
            "name": "privateDnsZoneConfigs",
            "count": "[length(variables('privateDnsZoneNames'))]",
            "input": {
              "name": "[replace(variables('privateDnsZoneNames')[copyIndex('privateDnsZoneConfigs')], '.', '-')]",
              "properties": {
                "privateDnsZoneId": "[variables('privateDnsZoneIds')[copyIndex('privateDnsZoneConfigs')]]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "newDnsZones",
        "[resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName'))]"
      ]
    }
  ],
  "outputs": {
    "foundryAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[parameters('foundryAccountName')]"
    },
    "foundryEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName')), '2025-06-01').endpoint]"
    },
    "privateEndpointId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/privateEndpoints', parameters('privateEndpointName'))]"
    },
    "vnetIdOut": {
      "type": "string",
      "value": "[variables('vnetId')]"
    },
    "subnetIdOut": {
      "type": "string",
      "value": "[variables('subnetId')]"
    }
  }
}