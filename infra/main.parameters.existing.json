{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westeurope"
    },
    "foundryAccountName": {
      "value": "my-foundry-account"
    },
    "skuName": {
      "value": "S0"
    },
    "vnetNewOrExisting": {
      "value": "existing"
    },
    "vnetName": {
      "value": "my-existing-vnet"
    },
    "vnetResourceGroup": {
      "value": "rg-network"
    },
    "subnetName": {
      "value": "pe-subnet"
    },
    "privateEndpointName": {
      "value": "my-foundry-account-pe"
    },
    "privateDnsZoneNewOrExisting": {
      "value": "existing"
    },
    "privateDnsZoneResourceGroup": {
      "value": "rg-dns"
    },
    "tags": {
      "value": {
        "workload": "microsoft-foundry-starter-pack",
        "environment": "prod"
      }
    }
  }
}
