{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus2"
    },
    "foundryAccountName": {
      "value": "my-foundry-account"
    },
    "skuName": {
      "value": "S0"
    },
    "vnetNewOrExisting": {
      "value": "new"
    },
    "vnetName": {
      "value": "foundry-vnet"
    },
    "vnetAddressPrefix": {
      "value": "10.0.0.0/16"
    },
    "subnetName": {
      "value": "foundry-pe-subnet"
    },
    "subnetAddressPrefix": {
      "value": "10.0.1.0/24"
    },
    "agentSubnetName": {
      "value": "foundry-agent-subnet"
    },
    "agentSubnetAddressPrefix": {
      "value": "10.0.2.0/24"
    },
    "privateDnsZoneNewOrExisting": {
      "value": "new"
    },
    "tags": {
      "value": {
        "workload": "microsoft-foundry-starter-pack",
        "environment": "demo"
      }
    }
  }
}
